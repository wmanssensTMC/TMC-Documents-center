# Copy to .env.local for local use. Never commit .env.local.
# On Vercel: Project > Settings > Environment Variables.

# Random secret that signs the login cookie (min. 32 characters).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Phase 0: one admin account. Users and roles move to the database in phase 1.
ADMIN_EMAIL=wilman@transmare.com
ADMIN_NAME=Willem Manssens
# Make with: npm run hash-password
ADMIN_PASSWORD_HASH=

# Phase 1. Both are filled in automatically when you create the stores in Vercel
# (project > Storage > Neon, and Storage > Blob). Leave empty on a laptop: the app then uses
# a built-in database (.data/pglite) and a local folder (.data/files).
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Phase 2: wake-up call to the worker (Railway). Optional on a laptop.
WORKER_WAKE_URL=
WORKER_WAKE_SECRET=

# AI reader (27/10/2026), worker only (Railway). Off unless AI_READER=on. The key comes from TMC's
# Anthropic account (a separate workspace with its own spend limit); never in git or chat.
# Start values for the measurement: effort medium, 3 calls per run, 30 per day, 120 s.
AI_READER=
ANTHROPIC_API_KEY=
AI_READER_MODEL=claude-opus-5-5
AI_READER_EFFORT=medium
AI_READER_MAX_CALLS=3
AI_READER_DAILY_CALLS=30
AI_READER_TIMEOUT_S=120
